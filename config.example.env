# EPCare 配置示例（复制为 .env 并按需修改；不要提交 .env）
CONTROL_URL=http://127.0.0.1:8001
EP_CONN=sta                 # 真机连接方式：sta（路由器组网）/ ap（直连）
SPEED_LIMIT=0.6             # 底盘限速 m/s
MAX_MOVE=1.0                # 单次位移上限 m
ARM_LIMIT_MM=60             # 机械臂单次位移上限 mm
BATTERY_FLOOR=15            # 低电量拒绝动作阈值 %
ENABLE_LLM=0                # 1 = 用本地 Qwen 归纳收纳规则（较慢）
EPCARE_API=http://127.0.0.1:8000
EPCARE_USER=admin
EPCARE_PASS=admin123
